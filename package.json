{
  "name": "creator-risk-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:auth-contract": "tsx scripts/auth-contract-smoke.ts",
    "test:contract": "tsx scripts/contract-smoke.ts",
    "test:csrf": "tsx scripts/csrf-smoke.ts",
    "test:fetch-all-pages": "tsx scripts/fetch-all-pages-smoke.ts",
    "test:prefetch-cache": "tsx scripts/prefetch-cache-smoke.ts",
    "test:progress-sync": "tsx scripts/progress-sync-smoke.ts",
    "test:report-warnings": "tsx scripts/report-warnings-smoke.ts",
    "test:script-cue": "tsx scripts/script-cue-smoke.ts",
    "test:stall-timer": "tsx scripts/stall-timer-smoke.ts",
    "test:upload-validation": "tsx scripts/upload-validation-smoke.ts",
    "test:youtube-id": "tsx scripts/youtube-id-smoke.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"server/**/*.ts\""
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "ws": "^8.21.3"
  }
}
